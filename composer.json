{
	"name": "medienbaecker/kirby-alter",
	"license": "MIT",
	"type": "kirby-plugin",
	"version": "6.0.0-rc.1",
	"authors": [
		{
			"name": "Thomas Günther",
			"email": "mail@medienbaecker.com"
		}
	],
	"require": {
		"php": "~8.3.0 || ~8.4.0 || ~8.5.0",
		"getkirby/cms": "^6.0",
		"getkirby/composer-installer": "^1.2"
	},
	"config": {
		"allow-plugins": {
			"getkirby/composer-installer": true
		}
	},
	"archive": {
		"exclude": [
			".github/",
			".DS_Store",
			".editorconfig",
			".gitattributes",
			".gitignore",
			"composer.lock",
			"node_modules/",
			"package-lock.json",
			"package.json",
			"src/",
			"vendor/"
		]
	}
}
